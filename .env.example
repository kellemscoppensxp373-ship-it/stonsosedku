# Required for ownership metadata. Use your numeric Telegram user ID.
ADMIN_ID=123456789
# Optional: used only for an explicit getMe diagnostics request. Never commit a real token.
CTRL_BOT_TOKEN=
MIN_REQUEST_DELAY=15
WEB_HOST=127.0.0.1
WEB_PORT=8080
# Optional local dashboard/API PIN. Leave blank to disable.
WEB_PIN=
# Optional SOCKS5 proxy (not configured unless PROXY_HOST and PROXY_PORT are set).
PROXY_HOST=
PROXY_PORT=
PROXY_USER=
PROXY_PASS=
